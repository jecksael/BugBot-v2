# === Telegram ===
BOT_TOKEN=
TARGET_CHAT_ID=-4830323896
TELEGRAM_THREAD_ID=      # opcional

# === Entorno ===
ENV=dev                  # dev | prod
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
TIMEZONE=America/Denver
POLLING_INTERVAL_SECONDS=300

# === BugBot v2.0 - Futuros de Índices ===
# Símbolos soportados: MNQ,MES,MGC
SYMBOLS=MNQ,MES,MGC

# Timeframe principal (scalping)
TIMEFRAME=5m             # 1m | 5m | 15m

# EMAs
EMA_FAST=21
EMA_SLOW=52

# === Risk Management por cuenta ===
# Cuenta activa (50000 o 100000)
ACCOUNT_SIZE=50000

# Riesgo por trade (0.006 = 0.6% ~ $300 en cuenta $50K)
RISK_PCT=0.006

# Stop por defecto en puntos (si no hay nivel estructural)
DEFAULT_STOP_POINTS=15

# === Fuente de datos ===
# csv | tradovate (por ahora usamos csv)
DATA_SOURCE=csv

# Carpeta donde dejas los CSV exportados de Wealthchart
CSV_PATH=data/

# === Apex Prop Firm ===
APEX_ACCOUNT=50000       # 50000 | 100000
# === IA para prospeccion.html (mensajes + Lista de 100) ===
# Token compartido que prospeccion.html manda en el header X-AI-Token.
# Invéntalo vos (ej: openssl rand -hex 24) y pegalo también en
# Config → Asistente de IA dentro de prospeccion.html.
AI_SHARED_SECRET=
# anthropic | openai — según qué API key tengas
AI_PROVIDER=anthropic
# Key del proveedor elegido (solo una de las dos, según AI_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Opcional — si lo dejas vacío usa claude-sonnet-5 (anthropic) o
# gpt-4o-mini (openai) por defecto
AI_MODEL=
