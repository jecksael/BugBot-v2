
# === Telegram ===
BOT_TOKEN=
TARGET_CHAT_ID=        # Ej: -1001234567890
TELEGRAM_THREAD_ID=    # opcional

# === Entorno ===
ENV=dev                # dev | prod
LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
TIMEZONE=America/Denver
POLLING_INTERVAL_SECONDS=60

# === Datos/Exchanges (para futuro) ===
        # binance | bybit | kraken | coinbase | ...
API_KEY=
API_SECRET=
API_PASSPHRASE=           # (solo algunos exchanges, ej. coinbase)

# Exchanges en orden de preferencia (failover)
EXCHANGES=kraken,coinbase

# Pares a analizar (separados por coma)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# TF y parámetros de la estrategia
TIMEFRAME=1H
EMA_FAST=21
EMA_SLOW=52

# Targets por % (0.6%, 1%, 2%) y SL 0.7%
TP_PCTS=0.006,0.01,0.02
SL_PCT=0.007